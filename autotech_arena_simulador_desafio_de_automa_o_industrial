      exportRankingCSV() {
        if (Store.users.length === 0) {
          AudioFX.error();
          this.showToast('Não há alunos cadastrados para exportar.', '⚠️');
          return;
        }

        AudioFX.click();
        const ranked = Store.getSortedRanking();
        const header = ['Posicao', 'Nome Completo', 'Turma/Equipe', 'Nivel Tecnico', 'Pontuacao Total (XP)', 'Missoes Concluidas', 'Acertos', 'Tentativas', 'Precisao (%)', 'Tempo Medio (s)'];
        const rows = ranked.map((u, idx) => {
          const acc = Math.round(Store.getAccuracy(u));
          const avgTime = u.attempts > 0 ? (u.totalTimeSec / u.attempts).toFixed(1).replace('.', ',') : '0,0';
          return [
            idx + 1,
            `"${u.name.replace(/"/g, '""')}"`,
            `"${u.turma.replace(/"/g, '""')}"`,
            `"${Store.getNivelTecnico(u.xp)}"`,
            u.xp,
            `${u.completedIds.length}/30`,
            u.correctCount,
            u.attempts,
            `${acc}%`,
            avgTime
          ].join(';');
        });

        const csvContent = '\uFEFF' + [header.join(';'), ...rows].join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `AutoTech_Arena_Notas_${new Date().toISOString().slice(0, 10)}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);

        this.showToast('Planilha CSV de notas exportada com sucesso!', '📥');
      },

