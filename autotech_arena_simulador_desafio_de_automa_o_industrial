<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AutoTech Arena — Simulador & Desafio de Automação Industrial</title>

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Tipografia Técnica: Chakra Petch (Títulos IHM/SCADA), Inter (Leitura) e JetBrains Mono (Dados/CLP/Cronômetro) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"Chakra Petch"', 'sans-serif'],
            sans: ['Inter', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          }
        }
      }
    }
  </script>

  <style>
    /* Estética Industrial IHM / SCADA (Siemens / Rockwell Inspired) */
    body {
      background-color: #0b1120;
      background-image:
        radial-gradient(circle at 50% 0%, rgba(6, 182, 212, 0.09), transparent 55%),
        linear-gradient(to right, rgba(30, 41, 59, 0.45) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(30, 41, 59, 0.45) 1px, transparent 1px);
      background-size: 100% 100%, 32px 32px, 32px 32px;
      color: #f8fafc;
      overflow-x: hidden;
    }

    .ihm-panel {
      background: linear-gradient(180deg, rgba(17, 24, 39, 0.96) 0%, rgba(11, 17, 32, 0.98) 100%);
      border: 1px solid #1e293b;
      box-shadow: 0 14px 36px -12px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .ihm-card {
      background: rgba(30, 41, 59, 0.48);
      border: 1px solid #334155;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    /* LEDs de Sinalização Industrial */
    .led-green { box-shadow: 0 0 10px #10b981, inset 0 0 4px #a7f3d0; }
    .led-cyan  { box-shadow: 0 0 10px #06b6d4, inset 0 0 4px #a5f3fc; }
    .led-amber { box-shadow: 0 0 10px #f59e0b, inset 0 0 4px #fde68a; }
    .led-red   { box-shadow: 0 0 12px #ef4444, inset 0 0 4px #fecaca; }

    /* Animações Vetoriais SVG para Fluxo de Sinal e Rotação */
    @keyframes flowDash {
      to { stroke-dashoffset: -24; }
    }
    .wire-live {
      stroke-dasharray: 8 4;
      animation: flowDash 0.65s linear infinite;
    }

    @keyframes spinAxis {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .spin-motor {
      transform-origin: center;
      animation: spinAxis 0.85s linear infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col font-sans antialiased selection:bg-cyan-500 selection:text-slate-950">

  <!-- ===================================================================== -->
  <!-- BARRA DE NAVEGAÇÃO SUPERIOR FIXA (IHM / SCADA + CRACHÁ DO ALUNO)      -->
  <!-- ===================================================================== -->
  <header class="sticky top-0 z-40 bg-[#0b1120]/95 backdrop-blur-md border-b border-slate-800 shadow-2xl">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 pt-3 pb-2.5 space-y-2.5">
      
      <!-- Linha Superior: Logo + Crachá do Aluno Logado + Controle de Som -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        
        <!-- Identidade Visual AutoTech Arena -->
        <button onclick="App.handleBrandClick()" class="flex items-center gap-3 text-left group focus:outline-none">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-cyan-400 via-sky-500 to-amber-500 p-0.5 shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform shrink-0">
            <div class="w-full h-full bg-[#0b1120] rounded-[10px] flex items-center justify-center">
              <svg class="w-6 h-6 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke="#f59e0b" d="M9 12h2l1-2 2 4 1-2h2" />
              </svg>
            </div>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-display font-bold text-lg sm:text-xl tracking-wider text-white">
                AUTOTECH <span class="text-cyan-400">ARENA</span>
              </span>
              <span class="hidden md:inline-block text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
                IHM/SCADA • 2º EM TÉCNICO
              </span>
            </div>
            <p class="text-[11px] text-slate-400 hidden sm:block">Simulador & Desafio de Automação Industrial</p>
          </div>
        </button>

        <!-- HUD Direita: Crachá do Aluno Logado + Controle de Som -->
        <div class="flex items-center gap-2 sm:gap-3">
          
          <!-- Crachá do Operador Ativo (ou Estado Sem Cadastro) -->
          <button onclick="App.switchTab('register')" id="header-badge-btn" class="flex items-center gap-2.5 bg-slate-900/95 hover:bg-slate-800 border border-slate-700 hover:border-cyan-400 rounded-xl px-2.5 py-1.5 transition-all text-left" title="Gerenciar Cadastro / Trocar Operador">
            <div id="header-avatar-box" class="w-9 h-9 rounded-lg bg-slate-800 border border-slate-600 overflow-hidden shrink-0 flex items-center justify-center">
              <!-- SVG do Avatar ou Ícone de Cadeado -->
            </div>
            <div class="leading-tight">
              <div class="flex items-center gap-1.5">
                <span id="header-user-name" class="text-xs font-bold text-amber-300 truncate max-w-[125px] sm:max-w-[170px]">Não Cadastrado</span>
                <span id="header-status-led" class="w-2 h-2 rounded-full bg-amber-400 led-amber shrink-0"></span>
              </div>
              <div class="flex items-center gap-1.5 text-[10px] font-mono">
                <span id="header-user-level" class="text-cyan-400 truncate max-w-[115px]">Faça o Cadastro</span>
                <span class="text-slate-600">•</span>
                <span id="header-xp" class="font-bold text-amber-400">0 XP</span>
              </div>
            </div>
          </button>

          <!-- Controle de Som Web Audio API -->
          <button id="btn-audio" onclick="App.toggleAudio()" class="p-2.5 rounded-xl bg-slate-900/95 hover:bg-slate-800 border border-slate-700 text-cyan-400 transition-all" title="Ativar/Desativar Efeitos Sonoros IHM">
            <svg id="icon-audio-on" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            </svg>
            <svg id="icon-audio-off" class="w-5 h-5 hidden text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Barra de Abas Principais -->
      <nav class="grid grid-cols-3 gap-2 pt-1 border-t border-slate-800/80" aria-label="Navegação Principal">
        <button id="tab-btn-modules" onclick="App.switchTab('modules')" class="py-2.5 px-2 sm:px-4 rounded-xl font-display font-bold text-xs sm:text-sm tracking-wider flex items-center justify-center gap-2 border transition-all bg-slate-900/80 text-slate-400 border-slate-800 hover:text-white hover:border-slate-600">
          <span>🏭</span>
          <span class="truncate">Missões / Módulos</span>
        </button>

        <button id="tab-btn-ranking" onclick="App.switchTab('ranking')" class="py-2.5 px-2 sm:px-4 rounded-xl font-display font-bold text-xs sm:text-sm tracking-wider flex items-center justify-center gap-2 border transition-all bg-slate-900/80 text-slate-400 border-slate-800 hover:text-white hover:border-slate-600">
          <span>🏆</span>
          <span class="truncate">Ranking da Turma</span>
        </button>

        <button id="tab-btn-register" onclick="App.switchTab('register')" class="py-2.5 px-2 sm:px-4 rounded-xl font-display font-bold text-xs sm:text-sm tracking-wider flex items-center justify-center gap-2 border transition-all bg-cyan-500/15 text-cyan-300 border-cyan-500/50">
          <span>👷</span>
          <span class="truncate">Cadastro / Operadores</span>
        </button>
      </nav>

    </div>
  </header>

  <!-- Toast / Notificação Flutuante IHM -->
  <div id="ihm-toast" class="hidden fixed bottom-5 right-5 z-50 max-w-sm bg-slate-900 border-2 border-cyan-400 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3 font-mono text-xs">
    <span id="ihm-toast-icon" class="text-base">ℹ️</span>
    <span id="ihm-toast-msg">Mensagem do sistema</span>
  </div>

  <!-- ===================================================================== -->
  <!-- ÁREA PRINCIPAL DE CONTEÚDO                                            -->
  <!-- ===================================================================== -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-6">

    <!-- =================================================================== -->
    <!-- ABA 1: 👷 CADASTRO DE OPERADOR (CRACHÁ TÉCNICO) & BANCADA           -->
    <!-- =================================================================== -->
    <section id="view-register" class="space-y-6">
      
      <!-- Banner de Boas-Vindas / Aviso Obrigatório (exibido quando não há operador logado ou ao tentar jogar sem cadastro) -->
      <div id="reg-onboarding-banner" class="ihm-panel rounded-2xl p-4 sm:p-5 border-2 border-amber-500/50 bg-gradient-to-r from-amber-950/35 via-slate-900 to-cyan-950/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400 flex items-center justify-center text-amber-300 text-lg shrink-0">
            🪪
          </div>
          <div>
            <div class="text-xs font-mono font-extrabold uppercase text-amber-400">CREDENCIAMENTO OBRIGATÓRIO NA BANCADA</div>
            <p id="reg-onboarding-text" class="text-xs sm:text-sm text-slate-200 mt-0.5">
              Nenhum operador ativo no momento. Preencha seu <strong>Nome Completo</strong>, informe sua <strong>Turma/Equipe</strong> e escolha um <strong>Avatar Industrial</strong> para liberar os desafios e entrar no Ranking Oficial da Turma.
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Coluna Esquerda (7 cols): Formulário de Cadastro de Novo Operador -->
        <div class="lg:col-span-7 ihm-panel rounded-2xl p-5 sm:p-7 space-y-5">
          <div class="border-b border-slate-800 pb-4">
            <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 font-bold">EMISSÃO DE CRACHÁ TÉCNICO</span>
            <h1 class="font-display text-2xl sm:text-3xl font-bold text-white mt-0.5">
              Cadastro de Operador
            </h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
              Cada aluno cadastrado recebe um crachá individual e aparece imediatamente no Ranking Oficial da Turma.
            </p>
          </div>

          <!-- Mensagem de Erro / Sucesso do Formulário -->
          <div id="reg-form-alert" class="hidden rounded-xl p-3.5 text-xs sm:text-sm font-mono flex items-center justify-between gap-3">
            <span id="reg-form-alert-msg"></span>
            <button id="reg-form-alert-cta" onclick="App.switchTab('modules')" class="hidden underline font-bold text-white shrink-0">
              Ir para Missões →
            </button>
          </div>

          <!-- Inputs Nome Completo + Turma/Equipe -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="reg-name-input" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">
                Nome Completo do Aluno *
              </label>
              <input
                id="reg-name-input"
                type="text"
                maxlength="36"
                placeholder="Ex: Ana Paula Ferreira"
                oninput="App.updateBadgePreview()"
                class="w-full bg-slate-950 border border-slate-700 focus:border-cyan-400 rounded-xl px-4 py-3 text-sm font-semibold text-white placeholder-slate-500 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="reg-turma-input" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">
                Turma / Equipe
              </label>
              <input
                id="reg-turma-input"
                type="text"
                list="turma-presets"
                maxlength="32"
                value="2º Ano A - Automação"
                placeholder="Ex: 2º Ano A - Automação"
                oninput="App.updateBadgePreview()"
                class="w-full bg-slate-950 border border-slate-700 focus:border-cyan-400 rounded-xl px-4 py-3 text-sm font-semibold text-white placeholder-slate-500 focus:outline-none transition-colors"
              />
              <datalist id="turma-presets">
                <option value="2º Ano A - Automação"></option>
                <option value="2º Ano B - Automação"></option>
                <option value="2º Ano C - Automação"></option>
                <option value="2º Ano Noturno - Automação"></option>
              </datalist>
            </div>
          </div>

          <!-- Seletor dos 8 Avatares Temáticos da Indústria -->
          <div>
            <label class="block text-xs font-mono uppercase text-slate-300 mb-2">
              Especialidade / Avatar Industrial (8 Opções):
            </label>
            <div id="avatar-selector-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <!-- Preenchido via JS -->
            </div>
          </div>

          <!-- Prévia do Crachá + Botão Cadastrar -->
          <div class="pt-3 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 bg-slate-950/90 border border-slate-800 rounded-xl p-2.5 w-full sm:w-auto">
              <div id="reg-preview-avatar" class="w-12 h-12 rounded-xl overflow-hidden border border-cyan-500/50 shrink-0"></div>
              <div class="leading-tight pr-2">
                <div class="text-[10px] font-mono text-slate-400">PRÉVIA DO CRACHÁ</div>
                <div id="reg-preview-name" class="font-display font-bold text-sm text-white truncate max-w-[180px]">Novo Operador</div>
                <div id="reg-preview-turma" class="text-[11px] font-mono text-cyan-400 truncate max-w-[180px]">2º Ano A - Automação</div>
              </div>
            </div>

            <button onclick="App.registerNewStudent()" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-slate-950 font-display font-bold text-sm tracking-wider shadow-lg shadow-cyan-500/20 transition-all active:scale-95 shrink-0">
              🪪 CADASTRAR E ATIVAR CRACHÁ
            </button>
          </div>
        </div>

        <!-- Coluna Direita (5 cols): Operadores Cadastrados nesta Bancada (Multi-aluno) -->
        <div class="lg:col-span-5 ihm-panel rounded-2xl p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3.5">
            <div>
              <span class="text-[11px] font-mono uppercase text-emerald-400 font-bold">MULTI-ALUNO NO MESMO PC</span>
              <h2 class="font-display text-lg sm:text-xl font-bold text-white">
                Operadores Cadastrados nesta Bancada
              </h2>
            </div>
            <span id="bench-count-badge" class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-700 font-mono text-xs font-bold text-cyan-400">
              0
            </span>
          </div>

          <p class="text-xs text-slate-400 leading-relaxed">
            Vários colegas usando o mesmo computador na aula? Basta cadastrar cada aluno ao lado e alternar o operador ativo com <strong>1 clique</strong> abaixo:
          </p>

          <div id="bench-operators-list" class="space-y-2.5 max-h-[430px] overflow-y-auto pr-1">
            <!-- Lista dinâmica de alunos cadastrados -->
          </div>
        </div>

      </div>
    </section>

    <!-- =================================================================== -->
    <!-- ABA 2: 🏭 MISSÕES / MÓDULOS (6 MÓDULOS + MARATONA INDUSTRIAL)       -->
    <!-- =================================================================== -->
    <section id="view-modules" class="hidden space-y-6">
      
      <!-- Painel Telemetria do Operador Logado -->
      <div class="ihm-panel rounded-2xl p-5 sm:p-7">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="space-y-2 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                PLC STATUS: RUN
              </span>
              <span id="dash-rank-badge" class="px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30 font-bold">
                NÍVEL: APRENDIZ IHM
              </span>
              <span class="px-2.5 py-1 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
                🔀 FISHER-YATES ATIVO
              </span>
            </div>

            <h1 class="font-display text-2xl sm:text-3xl font-bold text-white tracking-wide">
              CENTRAL DE MISSÕES <span class="text-cyan-400">SCADA</span>
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Operador(a) <strong id="dash-welcome-name" class="text-amber-400">Técnico(a)</strong>, selecione um dos <strong>6 Módulos Técnicos</strong> (5 questões cada) ou encare a <strong>Maratona Industrial</strong>. Questões e alternativas são embaralhadas a cada rodada!
            </p>
          </div>

          <!-- KPIs do Aluno Logado -->
          <div class="grid grid-cols-3 gap-2.5 sm:gap-3 shrink-0">
            <div class="ihm-card rounded-xl p-3 sm:p-4 text-center">
              <div class="text-[10px] font-mono text-slate-400">CONCLUÍDAS</div>
              <div id="dash-kpi-done" class="text-lg sm:text-2xl font-mono font-extrabold text-cyan-400 mt-1">0/30</div>
            </div>
            <div class="ihm-card rounded-xl p-3 sm:p-4 text-center">
              <div class="text-[10px] font-mono text-slate-400">PRECISÃO</div>
              <div id="dash-kpi-acc" class="text-lg sm:text-2xl font-mono font-extrabold text-emerald-400 mt-1">0%</div>
            </div>
            <div class="ihm-card rounded-xl p-3 sm:p-4 text-center">
              <div class="text-[10px] font-mono text-slate-400">POSIÇÃO</div>
              <div id="dash-kpi-pos" class="text-lg sm:text-2xl font-mono font-extrabold text-amber-400 mt-1">#1</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Modo Extra: Maratona Industrial (Desafio Misto) -->
      <div class="ihm-panel rounded-2xl p-5 sm:p-6 border-2 border-amber-500/50 bg-gradient-to-r from-amber-950/30 via-slate-900 to-cyan-950/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-2xl bg-amber-500/20 border border-amber-400 flex items-center justify-center text-2xl shrink-0 shadow-lg shadow-amber-500/10">
            ⚡
          </div>
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[10px] font-mono font-extrabold uppercase px-2 py-0.5 rounded bg-amber-500 text-slate-950">
                MODO EXTRA • BÔNUS +250 XP
              </span>
              <span class="text-xs font-mono text-cyan-300">10 Questões Sorteadas • Todos os 6 Temas</span>
            </div>
            <h2 class="font-display text-lg sm:text-xl font-bold text-white">
              Maratona Industrial (Desafio Misto)
            </h2>
            <p class="text-xs sm:text-sm text-slate-300">
              Sorteia 10 desafios misturados entre Portas Lógicas, CLP, Sensores, Variáveis Físicas, Pneumática e Motores Elétricos com alternativas embaralhadas e bônus extra de conclusão!
            </p>
          </div>
        </div>

        <button onclick="App.startMarathon()" class="w-full md:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-display font-bold text-sm tracking-wider shadow-lg shadow-amber-500/20 transition-all active:scale-95 shrink-0">
          🔀 INICIAR MARATONA →
        </button>
      </div>

      <!-- Grade dos 6 Módulos Técnicos (30 Questões) -->
      <div>
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <h2 class="font-display text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-sm bg-cyan-400 led-cyan"></span>
            Módulos Técnicos (6 Áreas • 30 Desafios Totais)
          </h2>
          <button onclick="App.switchTab('register')" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 underline">
            Trocar / Cadastrar Outro Operador →
          </button>
        </div>

        <div id="modules-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
