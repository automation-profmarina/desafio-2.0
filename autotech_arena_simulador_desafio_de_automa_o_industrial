          this.renderModulesView();
          document.getElementById('view-modules').classList.remove('hidden');
        } else if (tab === 'ranking') {
          this.renderRankingView();
          document.getElementById('view-ranking').classList.remove('hidden');
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
      },

