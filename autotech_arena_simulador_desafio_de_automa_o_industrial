        this.toastTimer = setTimeout(() => {
          toast.classList.add('hidden');
        }, 3800);
      },

      toggleAudio() {
        AudioFX.enabled = !AudioFX.enabled;
        if (AudioFX.enabled) AudioFX.click();
        document.getElementById('icon-audio-on').classList.toggle('hidden', !AudioFX.enabled);
        document.getElementById('icon-audio-off').classList.toggle('hidden', AudioFX.enabled);
