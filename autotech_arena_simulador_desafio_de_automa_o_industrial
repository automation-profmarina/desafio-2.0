    /**
     * 5. GERENCIADOR DE ESTADO E PERSISTÊNCIA (100% VAZIO POR PADRÃO — SEM BOTS)
     */
    const Store = {
      STORAGE_KEY: 'autotech_arena_exclusivo_v1',
      currentUserId: null,
      users: [], // Sempre inicia 100% vazio — apenas alunos cadastrados na bancada!

      load() {
        try {
          const raw = localStorage.getItem(this.STORAGE_KEY);
          if (raw) {
            const data = JSON.parse(raw);
            if (Array.isArray(data.users)) {
              this.users = data.users;
              this.currentUserId = data.currentUserId && this.users.some(u => u.id === data.currentUserId)
                ? data.currentUserId
                : (this.users[0]?.id || null);
              return;
            }
          }
        } catch (e) {
          console.warn('Erro ao ler localStorage:', e);
        }

        // Inicia 100% limpo, sem nenhum nome fictício ou bot
        this.users = [];
        this.currentUserId = null;
      },

      save() {
        try {
          localStorage.setItem(this.STORAGE_KEY, JSON.stringify({
            currentUserId: this.currentUserId,
            users: this.users
          }));
        } catch (e) {
          console.warn('Erro ao salvar localStorage:', e);
        }
      },

      clearAll() {
        this.users = [];
        this.currentUserId = null;
        try {
          localStorage.removeItem(this.STORAGE_KEY);
        } catch (e) {}
      },

      getCurrentUser() {
        if (!this.currentUserId) return null;
        return this.users.find(u => u.id === this.currentUserId) || null;
      },

      getNivelTecnico(xp) {
        if (xp >= 2800) return 'Engenheiro Sênior';
        if (xp >= 1700) return 'Técnico Pleno';
        if (xp >= 800) return 'Operador Especialista';
        return 'Aprendiz IHM';
      },

      getAvgResponseTime(user) {
        if (!user || !user.attempts || user.attempts === 0) return Infinity;
        return user.totalTimeSec / user.attempts;
      },

      getAccuracy(user) {
        if (!user || !user.attempts || user.attempts === 0) return 0;
        return (user.correctCount / user.attempts) * 100;
      },

      // Ordenação: Pontuação Total (XP) > Precisão (%) > Melhor Tempo Médio (s)
      getSortedRanking() {
        return [...this.users].sort((a, b) => {
          if (b.xp !== a.xp) return b.xp - a.xp;
          const accA = this.getAccuracy(a);
          const accB = this.getAccuracy(b);
          if (Math.abs(accB - accA) > 0.01) return accB - accA;
          return this.getAvgResponseTime(a) - this.getAvgResponseTime(b);
        });
      }
    };

    /**
