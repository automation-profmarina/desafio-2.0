      registerNewStudent() {
        const nameInput = document.getElementById('reg-name-input');
        const turmaInput = document.getElementById('reg-turma-input');
        const alertBox = document.getElementById('reg-form-alert');
        const alertMsg = document.getElementById('reg-form-alert-msg');
        const alertCta = document.getElementById('reg-form-alert-cta');

        const cleanName = nameInput.value.trim().replace(/\s+/g, ' ');
        const cleanTurma = turmaInput.value.trim() || '2º Ano A - Automação';

        // Validação 1: Nome obrigatório
        if (cleanName.length < 3) {
          AudioFX.error();
          alertBox.className = 'rounded-xl p-3.5 text-xs sm:text-sm font-mono flex items-center justify-between gap-3 bg-red-500/15 border border-red-500/40 text-red-300';
          alertMsg.textContent = '⚠ Insira seu Nome Completo (mínimo 3 caracteres) para emitir o crachá.';
          alertCta.classList.add('hidden');
          alertBox.classList.remove('hidden');
          nameInput.focus();
          return;
        }

        // Validação 2: Não duplicar nomes iguais na bancada
        const duplicate = Store.users.some(u => u.name.toLowerCase() === cleanName.toLowerCase());
        if (duplicate) {
          AudioFX.error();
          alertBox.className = 'rounded-xl p-3.5 text-xs sm:text-sm font-mono flex items-center justify-between gap-3 bg-amber-500/15 border border-amber-500/40 text-amber-300';
          alertMsg.textContent = `⚠ O operador "${cleanName}" já está cadastrado nesta bancada! Selecione-o na lista ao lado ou use seu sobrenome.`;
          alertCta.classList.add('hidden');
          alertBox.classList.remove('hidden');
          return;
        }

        // Cria o novo aluno cadastrado (100% real, inicia com 0 XP)
        const newStudent = {
          id: 'op_' + Date.now() + '_' + Math.floor(Math.random() * 999),
          name: cleanName,
          turma: cleanTurma,
          avatarId: this.selectedAvatarId,
          xp: 0,
          completedIds: [],
          attempts: 0,
          correctCount: 0,
          totalTimeSec: 0
        };

        Store.users.push(newStudent);
        Store.currentUserId = newStudent.id;
        Store.save();

        AudioFX.success();
        nameInput.value = '';
        this.syncHeader();
        this.renderRegisterView();

        alertBox.className = 'rounded-xl p-3.5 text-xs sm:text-sm font-mono flex items-center justify-between gap-3 bg-emerald-500/15 border border-emerald-500/40 text-emerald-300';
        alertMsg.textContent = `✓ Crachá emitido para "${cleanName}"! Você já está no Ranking Oficial da Turma.`;
