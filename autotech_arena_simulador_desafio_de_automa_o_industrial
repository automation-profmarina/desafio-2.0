      switchTab(tab, silent = false) {
        if (!silent) AudioFX.click();
        this.stopTimer();

        // Bloqueia acesso às Missões caso nenhum aluno esteja cadastrado ainda
        if (tab === 'modules' && !Store.getCurrentUser()) {
          tab = 'register';
          if (!silent) {
            this.showToast('Realize seu cadastro na bancada para liberar as missões!', '⚠️');
          }
        }

        this.activeTab = tab;

        ['view-modules', 'view-register', 'view-ranking', 'view-challenge', 'view-summary'].forEach(id => {
          document.getElementById(id).classList.add('hidden');
        });

        ['modules', 'ranking', 'register'].forEach(t => {
          const btn = document.getElementById(`tab-btn-${t}`);
          if (t === tab) {
            btn.className = 'py-2.5 px-2 sm:px-4 rounded-xl font-display font-bold text-xs sm:text-sm tracking-wider flex items-center justify-center gap-2 border transition-all bg-cyan-500/15 text-cyan-300 border-cyan-500/50';
