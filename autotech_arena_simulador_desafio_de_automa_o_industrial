      // ===================================================================
      // MOTOR DE DESAFIOS COM EMBARALHAMENTO FISHER-YATES
      // ===================================================================
      startModule(modIdx) {
        if (!Store.getCurrentUser()) {
          this.switchTab('register');
          return;
        }
        AudioFX.click();
        const mod = MODULES[modIdx];
        this.sessionConfig = {
          type: 'module',
          modIdx,
          title: `Módulo 0${mod.number}: ${mod.title}`
        };

        const mapped = mod.challenges.map(ch => ({
          ...ch,
          moduleLabel: `MÓDULO 0${mod.number}: ${mod.title}`
        }));

        // Embaralha a ordem das questões via Fisher-Yates
        this.sessionQueue = shuffleArray(mapped);
        this.sessionIdx = 0;
        this.sessionHits = 0;
        this.sessionXpEarned = 0;
        this.comboStreak = 0;

        this.loadCurrentQuestion();
      },

      startMarathon() {
        if (!Store.getCurrentUser()) {
          this.switchTab('register');
          return;
        }
        AudioFX.click();
        this.sessionConfig = {
          type: 'marathon',
          title: 'Maratona Industrial (Desafio Misto)'
        };

        const allPool = [];
        MODULES.forEach(mod => {
          mod.challenges.forEach(ch => {
            allPool.push({
              ...ch,
              moduleLabel: `MÓDULO 0${mod.number}: ${mod.title}`
            });
          });
        });

        // Embaralha todas as 30 questões via Fisher-Yates e sorteia 10
        this.sessionQueue = shuffleArray(allPool).slice(0, 10);
        this.sessionIdx = 0;
        this.sessionHits = 0;
        this.sessionXpEarned = 0;
        this.comboStreak = 0;

        this.loadCurrentQuestion();
      },

      replayCurrentSession() {
        if (!this.sessionConfig) {
          this.switchTab('modules');
          return;
        }
        if (this.sessionConfig.type === 'marathon') {
          this.startMarathon();
        } else {
          this.startModule(this.sessionConfig.modIdx);
        }
      },

      loadCurrentQuestion() {
        this.stopTimer();
        this.answered = false;
        this.answerStatus = 'idle';
        this.inspectMode = false;

        const ch = this.sessionQueue[this.sessionIdx];
        this.timeTotal = ch.timeLimit;
        this.timeLeft = ch.timeLimit;

        // Embaralha as 4 alternativas desta questão via Fisher-Yates
        this.currentShuffledOptions = shuffleArray(ch.options);

        ['view-modules', 'view-register', 'view-ranking', 'view-summary'].forEach(id => {
          document.getElementById(id).classList.add('hidden');
        });
        document.getElementById('view-challenge').classList.remove('hidden');
        document.getElementById('ch-feedback-panel').classList.add('hidden');

        document.getElementById('ch-module-badge').textContent = ch.moduleLabel;
        document.getElementById('ch-step-text').textContent = `Questão ${this.sessionIdx + 1} de ${this.sessionQueue.length}`;
        document.getElementById('ch-title').textContent = ch.title;
        document.getElementById('ch-context').textContent = ch.context;
        document.getElementById('ch-objective').textContent = ch.objective;
        document.getElementById('ch-svg-caption').textContent = ch.svgCaption;
        document.getElementById('ch-inspect-status').textContent = 'Modo: Leitura Nominal';
        document.getElementById('ch-inspect-status').className = 'text-slate-500';

        // Indicador de Combo/Sequência
        const comboBadge = document.getElementById('ch-combo-badge');
        if (this.comboStreak >= 2) {
          comboBadge.textContent = `🔥 COMBO ${this.comboStreak}x`;
          comboBadge.classList.remove('hidden');
        } else {
          comboBadge.classList.add('hidden');
        }

        this.renderChallengeSvg();
        this.renderChallengeOptions();
        this.startTimer();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      },

      toggleInspectSignal() {
        AudioFX.click();
        this.inspectMode = !this.inspectMode;
        const statusEl = document.getElementById('ch-inspect-status');
        if (this.inspectMode) {
          statusEl.textContent = 'Modo: Telemetria / Sinal Simulado ATIVO';
          statusEl.className = 'text-cyan-400 font-bold';
        } else {
          statusEl.textContent = 'Modo: Leitura Nominal';
          statusEl.className = 'text-slate-500';
        }
        this.renderChallengeSvg();
      },

      renderChallengeSvg() {
        const ch = this.sessionQueue[this.sessionIdx];
        document.getElementById('ch-svg-stage').innerHTML = ch.renderSvg(this.inspectMode, this.answerStatus);
      },

      renderChallengeOptions() {
        const letters = ['A', 'B', 'C', 'D'];
        const list = document.getElementById('ch-options-list');

        list.innerHTML = this.currentShuffledOptions.map((opt, idx) => `
          <button id="opt-btn-${idx}" onclick="App.submitAnswer(${idx})" class="w-full p-3.5 sm:p-4 rounded-xl bg-slate-900/95 hover:bg-slate-800 border border-slate-700 hover:border-cyan-400 text-left flex items-start gap-3 transition-all group">
            <span class="w-7 h-7 rounded-lg bg-slate-800 group-hover:bg-cyan-500 text-cyan-400 group-hover:text-slate-950 font-mono font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5 transition-colors">
              ${letters[idx]}
            </span>
            <span class="text-xs sm:text-sm text-slate-200 leading-snug">${opt.text}</span>
          </button>
        `).join('');
      },

      startTimer() {
        this.stopTimer();
        let prevSec = Math.ceil(this.timeLeft);
        this.updateTimerDisplay();

        this.timerHandle = setInterval(() => {
          this.timeLeft = Math.max(0, this.timeLeft - 0.1);
          const curSec = Math.ceil(this.timeLeft);

          if (curSec !== prevSec) {
            prevSec = curSec;
            // Alerta sonoro nos últimos 5 segundos
            if (curSec <= 5 && curSec > 0) {
              AudioFX.tickUrgent();
            }
          }

          this.updateTimerDisplay();

          if (this.timeLeft <= 0) {
            this.stopTimer();
            this.submitAnswer(-1, true);
          }
        }, 100);
      },

      stopTimer() {
        if (this.timerHandle) {
          clearInterval(this.timerHandle);
          this.timerHandle = null;
        }
      },

      // Barra de progresso muda: Verde -> Âmbar -> Vermelho pulsante nos últimos 5s
      updateTimerDisplay() {
        const secs = Math.ceil(this.timeLeft);
        const pct = (this.timeLeft / this.timeTotal) * 100;
        const txt = document.getElementById('ch-timer-text');
        const bar = document.getElementById('ch-timer-bar');
        const box = document.getElementById('ch-timer-box');

        txt.textContent = `00:${secs < 10 ? '0' + secs : secs}`;
        bar.style.width = `${pct}%`;

        if (secs <= 5) {
          txt.className = 'text-xl sm:text-2xl font-mono font-extrabold text-red-400 tabular-nums animate-pulse';
          bar.className = 'h-full rounded-full bg-red-500 animate-pulse transition-all duration-100';
          box.className = 'flex items-center gap-3 bg-red-950/60 border border-red-500 rounded-xl px-4 py-2 transition-colors';
        } else if (pct <= 50) {
          txt.className = 'text-xl sm:text-2xl font-mono font-extrabold text-amber-400 tabular-nums';
          bar.className = 'h-full rounded-full bg-amber-400 transition-all duration-100';
          box.className = 'flex items-center gap-3 bg-slate-950 border border-amber-500/50 rounded-xl px-4 py-2 transition-colors';
        } else {
          txt.className = 'text-xl sm:text-2xl font-mono font-extrabold text-emerald-400 tabular-nums';
          bar.className = 'h-full rounded-full bg-emerald-400 transition-all duration-100';
          box.className = 'flex items-center gap-3 bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 transition-colors';
        }
      },

      submitAnswer(selectedIdx, timedOut = false) {
        if (this.answered) return;
        this.answered = true;
        this.stopTimer();

        const ch = this.sessionQueue[this.sessionIdx];
        const elapsedSec = Math.max(0.5, this.timeTotal - this.timeLeft);
        const correctIdx = this.currentShuffledOptions.findIndex(o => o.isCorrect);
        const isCorrect = !timedOut && selectedIdx === correctIdx;

        // Atualiza telemetria do aluno cadastrado no Store
        const user = Store.getCurrentUser();
        user.attempts += 1;
        user.totalTimeSec += elapsedSec;

        let xpGained = 0;
        let speedBonus = 0;
        let comboBonus = 0;

        if (isCorrect) {
          this.answerStatus = 'correct';
          this.inspectMode = true;
          this.sessionHits += 1;
          this.comboStreak += 1;

          // Cálculo de Bônus de Velocidade (até +50 XP) e Bônus de Combo
          speedBonus = Math.round((this.timeLeft / this.timeTotal) * 50);
          comboBonus = this.comboStreak >= 2 ? (this.comboStreak - 1) * 15 : 0;
          xpGained = 100 + speedBonus + comboBonus;

          user.xp += xpGained;
          user.correctCount += 1;
          if (!user.completedIds.includes(ch.id)) {
            user.completedIds.push(ch.id);
          }

          this.sessionXpEarned += xpGained;
          AudioFX.success();
        } else {
          this.answerStatus = 'wrong';
          this.comboStreak = 0;
          AudioFX.error();
        }

        Store.save();
        this.syncHeader();
        this.renderChallengeSvg();

        // Atualiza indicador de combo no cabeçalho da questão
        const comboBadge = document.getElementById('ch-combo-badge');
        if (this.comboStreak >= 2) {
          comboBadge.textContent = `🔥 COMBO ${this.comboStreak}x`;
          comboBadge.classList.remove('hidden');
        } else {
          comboBadge.classList.add('hidden');
        }

        // Destaca a correta em verde e a errada em vermelho
        this.currentShuffledOptions.forEach((_, idx) => {
          const btn = document.getElementById(`opt-btn-${idx}`);
          btn.disabled = true;

          if (idx === correctIdx) {
            btn.className = 'w-full p-3.5 sm:p-4 rounded-xl bg-emerald-500/20 border-2 border-emerald-400 text-left flex items-start gap-3 shadow-lg shadow-emerald-500/15';
            btn.querySelector('span').className = 'w-7 h-7 rounded-lg bg-emerald-400 text-slate-950 font-mono font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5';
          } else if (idx === selectedIdx) {
            btn.className = 'w-full p-3.5 sm:p-4 rounded-xl bg-red-500/20 border-2 border-red-400 text-left flex items-start gap-3';
            btn.querySelector('span').className = 'w-7 h-7 rounded-lg bg-red-400 text-slate-950 font-mono font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5';
          } else {
            btn.className = 'w-full p-3.5 sm:p-4 rounded-xl bg-slate-900/40 border border-slate-800 text-left flex items-start gap-3 opacity-45';
          }
        });

        // Exibe a "Análise Técnica do Engenheiro"
        const fb = document.getElementById('ch-feedback-panel');
        const icon = document.getElementById('fb-badge-icon');
        const label = document.getElementById('fb-status-label');
        const head = document.getElementById('fb-headline');
        const xpTag = document.getElementById('fb-xp-tag');

        fb.classList.remove('hidden');

        if (isCorrect) {
          fb.className = 'ihm-panel rounded-2xl p-5 sm:p-6 border-2 border-emerald-500/60 bg-emerald-950/20 space-y-4';
          icon.className = 'w-11 h-11 rounded-xl bg-emerald-500 text-slate-950 flex items-center justify-center font-bold text-xl shrink-0';
          icon.textContent = '✓';
          label.className = 'text-xs font-mono font-extrabold uppercase tracking-wider text-emerald-400';
          label.textContent = `SOLUÇÃO VALIDADA EM ${elapsedSec.toFixed(1)}s`;
          head.textContent = 'Diagnóstico Técnico Correto!';
          xpTag.className = 'px-4 py-2 rounded-xl bg-amber-500/20 border border-amber-400 text-amber-300 font-mono font-extrabold text-xs sm:text-sm';
          xpTag.textContent = `+${xpGained} XP (100 + ${speedBonus} vel${comboBonus > 0 ? ` + ${comboBonus} combo` : ''})`;
        } else {
          fb.className = 'ihm-panel rounded-2xl p-5 sm:p-6 border-2 border-red-500/60 bg-red-950/20 space-y-4';
          icon.className = 'w-11 h-11 rounded-xl bg-red-500 text-white flex items-center justify-center font-bold text-xl shrink-0';
          icon.textContent = '✕';
          label.className = 'text-xs font-mono font-extrabold uppercase tracking-wider text-red-400';
          label.textContent = timedOut ? 'TEMPO ESGOTADO NA BANCADA' : 'FALHA DE PARÂMETRO TÉCNICO';
          head.textContent = timedOut ? 'O tempo da manobra esgotou!' : 'Alternativa Incorreta!';
          xpTag.className = 'px-4 py-2 rounded-xl bg-slate-900 border border-slate-700 text-slate-400 font-mono font-extrabold text-xs sm:text-sm';
          xpTag.textContent = '+0 XP (Combo Zerado)';
        }

        document.getElementById('fb-explanation').textContent = ch.explanation;

        const isLast = this.sessionIdx >= this.sessionQueue.length - 1;
        document.getElementById('fb-next-btn').textContent = isLast ? 'Concluir Relatório de Turno 🏆' : 'Próxima Questão →';

        setTimeout(() => fb.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
      },

      advanceChallenge() {
        AudioFX.click();
        if (this.sessionIdx < this.sessionQueue.length - 1) {
          this.sessionIdx += 1;
          this.loadCurrentQuestion();
        } else {
          this.finishSession();
        }
      },

      finishSession() {
        this.stopTimer();
        let marathonBonus = 0;

        // Aplica Bônus Extra de +250 XP na conclusão da Maratona Industrial
        if (this.sessionConfig?.type === 'marathon') {
          marathonBonus = 250;
          const user = Store.getCurrentUser();
          if (user) {
            user.xp += marathonBonus;
            Store.save();
            this.syncHeader();
          }
          this.sessionXpEarned += marathonBonus;
        }

        AudioFX.success();
        const total = this.sessionQueue.length;
        const acc = Math.round((this.sessionHits / total) * 100);

        document.getElementById('view-challenge').classList.add('hidden');
        document.getElementById('view-summary').classList.remove('hidden');

        document.getElementById('sum-title').textContent = `${this.sessionConfig.title.toUpperCase()} — CONCLUÍDO!`;
        document.getElementById('sum-hits').textContent = `${this.sessionHits}/${total}`;
        document.getElementById('sum-acc').textContent = `${acc}%`;
        document.getElementById('sum-xp').textContent = `+${this.sessionXpEarned}`;

        const bonusNote = document.getElementById('sum-marathon-bonus-note');
        if (marathonBonus > 0) {
          bonusNote.classList.remove('hidden');
        } else {
          bonusNote.classList.add('hidden');
        }
      },

      exitChallenge() {
        AudioFX.click();
        this.stopTimer();
        this.switchTab('modules', true);
      }
    };

    window.addEventListener('DOMContentLoaded', () => App.init());
  </script>
</body>
</html>
