     */
    function shuffleArray(array) {
      const arr = [...array];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    /**
     * 2. SINTETIZADOR DE EFEITOS SONOROS VIA WEB AUDIO API (SEM URLS EXTERNAS)
     */
    const AudioFX = {
      ctx: null,
      enabled: true,

      boot() {
        if (!this.ctx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) this.ctx = new AC();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },

      tone(freq = 600, duration = 0.05, type = 'triangle', vol = 0.14) {
        if (!this.enabled) return;
        this.boot();
        if (!this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
        gain.gain.setValueAtTime(vol, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + duration + 0.01);
      },

      click() {
        this.tone(660, 0.045, 'triangle', 0.13);
      },

      tickUrgent() {
        this.tone(960, 0.075, 'sine', 0.14);
      },

      success() {
        if (!this.enabled) return;
        this.boot();
        if (!this.ctx) return;
        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
          setTimeout(() => this.tone(f, 0.2, 'triangle', 0.15), i * 75);
        });
      },

      error() {
        if (!this.enabled) return;
        this.boot();
        if (!this.ctx) return;
        this.tone(210, 0.18, 'sawtooth', 0.15);
        setTimeout(() => this.tone(155, 0.24, 'sawtooth', 0.15), 145);
      }
    };

